// prisma/schema.prisma
// Loisu / AgriMap Pro - Prisma andmebaasi skeem

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATE_DATABASE_URL") // db push ja skeemimuudatused tabelite omaniku rolliga
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "darwin-arm64"]
}

// ============================================================================
// ENUMS
// ============================================================================

enum FieldStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum PoiCategory {
  DRYER
  WATER_SOURCE
  WORKSHOP
  FUEL_STATION
  FIELD_ENTRANCE
  STORAGE
  SCALE
  OTHER
}

enum VehicleType {
  TRACTOR
  COMBINE
  SPRAYER
  SPREADER
  TRUCK
  ATV
  LOADER
}

enum ImplementType {
  CULTIVATOR
  SEEDER
  SPRAYER
  HEADER
  DISC_HARROW
  PLOW
  MOWER
  TRAILER
  FERTILIZER_SPREADER
  ROLLER
  OTHER
}

enum DeviceStatus {
  WORKING
  MOVING
  STOPPED
  IDLING
  OFFLINE
}

enum OwnershipType {
  OWNED
  RENTED
  UNKNOWN // maaomanik või põllu operaator sisestamata
}

enum PartyType {
  PERSON
  LEGAL_ENTITY
}

enum PartyRole {
  LANDOWNER
  DRIVER // kuvatakse "Töötaja"
  OPERATOR
  SUPPLIER // "Tarnija" (laokannete arvele võtmine)
  OTHER // "Muu seotud isik" (täpsustus märkustes)
}

// ============================================================================
// 1. HOOAJAD (SEASONS)
// ============================================================================

model Season {
  id        Int       @id @default(autoincrement())
  tenantId  String    @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  year      Int
  name      String
  isLocked  Boolean   @default(false)
  closedAt  DateTime?
  closedBy  String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy String? // viimase muutja kasutajatunnus (täidetakse automaatselt)

  fieldSeasons FieldSeason[]
  harvestLots  HarvestLot[]

  @@unique([tenantId, year])
  @@index([tenantId])
  @@map("seasons")
}

// ============================================================================
// 2. KATASTRIÜKSUSED (CADASTRAL PARCELS)
// ============================================================================

model CadastralParcel {
  id            Int      @id @default(autoincrement())
  tenantId      String   @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  cadastralCode String // Katastritunnus (nt "89201:001:0100")
  name          String? // Katastriüksuse nimi / lähiaadress
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy     String? // viimase muutja kasutajatunnus (täidetakse automaatselt)

  seasonLinks FieldCadastralParcel[]

  @@unique([tenantId, cadastralCode])
  @@index([tenantId])
  @@map("cadastral_parcels")
}

// ============================================================================
// 3. PÕLLUD / MASSIIVID (MASTER FIELDS)
// ============================================================================

model Field {
  id             Int      @id @default(autoincrement())
  tenantId       String   @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  num            String // PRIA põllu number impordist / kasutaja antud (nt "4", "4-1", "x") — võib massiivi siseselt korduda eri operaatoritel
  name           String // Kasutaja määratud nimi (nt "Murikatsi Mirka", "Toosi")
  fieldCode      String // PRIA massiivi number (nt "60844249726") — võib korduda, kui massiiv on jagatud mitme operaatori vahel
  cadastralCode  String? // Peamine katastritunnus (tagasiühilduvuse jaoks)
  soilType       String? // Mullastik (nt "Leostunud liivsavi (LP)")
  drainageSystem Boolean  @default(false)
  operatorId     String? // Põllu operaator (seotud isikute registrist)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy      String? // viimase muutja kasutajatunnus (täidetakse automaatselt)

  fieldSeasons FieldSeason[]
  operator     RelatedParty? @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  warehouse    Warehouse? // põllu ladu: koristatud punkrid enne vedu (luuakse esimesel koristusel)

  @@unique([tenantId, fieldCode, num, operatorId])
  // Massiivinumber + põllunumber võivad korduda (nt kui operaator vahetub),
  // aga sama operaator ei saa sama massiivi+põllu numbrit kaks korda omada.
  @@index([operatorId])
  @@index([tenantId])
  @@map("fields")
}

// ============================================================================
// 4. PÕLLU HOOAJA KIRJED (FIELD SEASONS - SEOS PÕLLU JA HOOAJA VAHEL)
// ============================================================================

model FieldSeason {
  id                  Int         @id @default(autoincrement())
  tenantId            String      @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  fieldId             Int
  seasonId            Int?
  year                Int
  areaHa              Float // Selle hooaja haritav pindala
  eligibleAreaHa      Float? // PRIA toetusõiguslik pindala
  areaChangeReason    String? // Pindala muutuse põhjus (nt võsastumine, kraavihooldus)
  crop                String
  cropVariety         String?
  cropColor           String      @default("#eab308")
  cropId              String? // registri kultuur; crop = selle nimi
  varietyId           String?
  undersowing         Undersowing @default(NONE) // allakülv (PRIA nimetuse jaoks)
  priaCropName        String? // PRIA kultuur: tuletatud salvestamisel või PRIA impordist; jääb hooajale alles
  targetYieldTonsHa   Float?
  actualYieldTonsHa   Float?
  workedAreaHa        Float       @default(0)
  workProgress        Float       @default(0)
  status              FieldStatus @default(NOT_STARTED)
  seedingDate         DateTime?
  harvestDate         DateTime?
  boundaryPointsCount Int? // Geomeetria tippude/punktide arv
  perimeterM          Float? // Ümbermõõt meetrites
  notes               String?
  geometry            Json // GeoJSON Polygon | MultiPolygon
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  createdBy           String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy           String? // viimase muutja kasutajatunnus (täidetakse automaatselt)

  field            Field                  @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  season           Season?                @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  cadastralParcels FieldCadastralParcel[]
  cropEntity       Crop?                  @relation(fields: [cropId], references: [id], onDelete: SetNull)
  varietyEntity    CropVariety?           @relation(fields: [varietyId], references: [id], onDelete: SetNull)
  fieldWorks       FieldWork[]
  tripFields       VehicleTripField[]

  @@unique([fieldId, year])
  @@index([fieldId])
  @@index([seasonId])
  @@index([year])
  @@index([cropId])
  @@index([varietyId])
  @@index([tenantId])
  @@map("field_seasons")
}

// ============================================================================
// 5. HOOAJAPÕHINE PÕLLU JA KATASTRIÜKSUSE SEOS (FIELD SEASON CADASTRAL PARCEL)
// Salvestab, mitu hektarit, millise omandivormi ja kuludega kataster sellel hooajal põllus on
// ============================================================================

// ============================================================================
// 4. SEOTUD ISIKUD JA PARTNERID (RELATED PARTIES / ENTITIES)
// Füüsilised ja juriidilised isikud: maaomanikud, rentnikud, juhid, kontaktid
// ============================================================================

model RelatedParty {
  id               String      @id @default(cuid())
  tenantId         String      @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  name             String // Täisnimi või ärinimi (nt "Loisu Agro OÜ", "Maret Paju")
  type             PartyType   @default(PERSON)
  code             String? // Isikukood või registrikood
  vatNumber        String? // KMKR number
  roles            PartyRole[] // Rollid süsteemis
  phone            String? // Telefon
  email            String? // E-post
  address          String? // Postiaadress / asukoht
  bankAccount      String? // IBAN arveldusarve (rendimakseteks / maamaksuks)
  serviceArticleId String? // töötaja tööaja teenus, kui erineb vaikimisi omast
  hourlyRate       Decimal?    @db.Decimal(12, 4) // oma tunnihind (näeb finantsõigusega)
  notes            String? // Märkused
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  createdBy        String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy        String? // viimase muutja kasutajatunnus (täidetakse automaatselt)

  cadastralParcels  FieldCadastralParcel[]
  fieldsAsOperator  Field[]
  workEntries       WorkEntry[]
  plannedFieldWorks FieldWork[]            @relation("FieldWorkPlannedWorker")
  stockDocuments    StockDocument[]        @relation("StockDocSupplier")
  serviceArticle    Article?               @relation("PartyService", fields: [serviceArticleId], references: [id], onDelete: SetNull)

  @@index([serviceArticleId])
  @@index([tenantId])
  @@map("related_parties")
}

model FieldCadastralParcel {
  id                Int           @id @default(autoincrement())
  tenantId          String        @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  fieldSeasonId     Int
  cadastralParcelId Int
  fieldAreaHa       Float // Hektarid sellest katastriüksusest sellel hooajal
  ownershipType     OwnershipType @default(UNKNOWN) // Tuletatud: omanik = põllu operaator → OWNED, muu → RENTED, omanik/operaator sisestamata → UNKNOWN (services/landTenure.ts)
  ownerName         String? // Omaniku nimi sellel hooajal
  ownerPartyId      String? // Seos seotud isikute registriga
  landTaxEurHa      Float? // Selle hooaja maamaks hektari kohta (€/ha)
  landTaxEurYear    Float? // Selle hooaja maamaks kokku (€/a)
  rentFeeEurHa      Float? // Selle hooaja renditasu hektari kohta (€/ha)
  rentFeeEurYear    Float? // Selle hooaja renditasu kokku (€/a)
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  createdBy         String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy         String? // viimase muutja kasutajatunnus (täidetakse automaatselt)

  fieldSeason     FieldSeason     @relation(fields: [fieldSeasonId], references: [id], onDelete: Cascade)
  cadastralParcel CadastralParcel @relation(fields: [cadastralParcelId], references: [id], onDelete: Cascade)
  ownerParty      RelatedParty?   @relation(fields: [ownerPartyId], references: [id], onDelete: SetNull)

  // Sama katastriüksus võib hooajal korduda (nt kaasomanikud: igal real oma omanik, pindala ja rent)
  @@index([fieldSeasonId, cadastralParcelId])
  @@index([fieldSeasonId])
  @@index([cadastralParcelId])
  @@index([ownerPartyId])
  @@index([tenantId])
  @@map("field_cadastral_parcels")
}

// ============================================================================
// 5. TARISTU / HUVI- JA TÖÖPUNKTID (POI)
// ============================================================================

model PointOfInterest {
  id             String      @id @default(cuid())
  tenantId       String      @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  name           String
  category       PoiCategory
  latitude       Float
  longitude      Float
  radiusM        Int         @default(25) // raadius (m), mille piires sõidu punkt loetakse selle objekti juures olevaks
  description    String?
  capacity       String?
  contactPerson  String?
  phone          String?
  accessNotes    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdBy      String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy      String? // viimase muutja kasutajatunnus (täidetakse automaatselt)

  warehouse    Warehouse?

  @@index([tenantId])
  @@map("points_of_interest")
}

// ============================================================================
// 6. MASINAPARK JA GPS SEADMED (FLEET & TELEMETRY)
// ============================================================================

model Vehicle {
  id                 String      @id @default(cuid())
  tenantId           String      @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  name               String
  type               VehicleType
  category           String? // Masina liik (vabatekst, isetäienev olemasolevatest)
  manufacturer       String? // Tootja
  model              String
  powerKw            Float? // Mootorivõimsus kW
  acquisitionCost    Float? // Soetusmaksumus (€)
  acquisitionDate    DateTime?   @db.Date // Soetamise kuupäev
  depreciationRate   Float? // Amortisatsioonimäär (% aastas)
  depreciationMethod String? // Amortisatsioonimeetod: LINEAR (lineaarne) | DECLINING (degressiivne)
  regNumber          String?
  serialNumber       String? // VIN / seerianumber
  year               Int? // väljalaskeaasta
  workingWidthM      Float       @default(6.0)
  color              String      @default("#10b981")
  fuelCapacityL      Float?
  serviceArticleId   String? // masina tööaja teenus, kui erineb vaikimisi omast
  hourlyRate         Decimal?    @db.Decimal(12, 4) // oma tunnihind (näeb finantsõigusega)
  fuelArticleId      String? // vaikimisi kütus (liik FUEL)
  lastLatitude       Float?
  lastLongitude      Float?
  lastActiveAt       DateTime?
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  createdBy          String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy          String? // viimase muutja kasutajatunnus (täidetakse automaatselt)

  serviceArticle       Article?              @relation("VehicleService", fields: [serviceArticleId], references: [id], onDelete: SetNull)
  fuelArticle          Article?              @relation("VehicleFuel", fields: [fuelArticleId], references: [id], onDelete: SetNull)
  deviceAssignments    DeviceAssignment[]
  implementAssignments ImplementAssignment[]
  workEntries          WorkEntry[]
  workEntryLines       WorkEntryLine[]

  @@index([serviceArticleId])
  @@index([fuelArticleId])
  @@index([tenantId])
  @@map("vehicles")
}

model Implement {
  id                 String        @id @default(cuid())
  tenantId           String        @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  name               String
  type               ImplementType
  category           String? // Haakeriista liik (vabatekst, eraldi masinate liikidest)
  workingWidthM      Float? // töölaius m; tühi = telemeetria ei arvuta haakeriista järgi pindala
  acquisitionCost    Float? // Soetusmaksumus (€)
  acquisitionDate    DateTime?     @db.Date // Soetamise kuupäev
  depreciationRate   Float? // Amortisatsioonimäär (% aastas)
  depreciationMethod String? // Amortisatsioonimeetod: LINEAR (lineaarne) | DECLINING (degressiivne)
  manufacturer       String?
  model              String?
  regNumber          String? // registrinumber (nt haagis)
  serialNumber       String? // VIN / seerianumber
  year               Int?
  serviceArticleId   String? // haakeriista tööaja teenus, kui erineb vaikimisi omast
  hourlyRate         Decimal?      @db.Decimal(12, 4) // oma tunnihind (näeb finantsõigusega)
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  createdBy          String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy          String? // viimase muutja kasutajatunnus (täidetakse automaatselt)

  deviceAssignments    DeviceAssignment[]
  implementAssignments ImplementAssignment[]
  workEntries          WorkEntry[]
  workEntryLines       WorkEntryLine[]
  serviceArticle       Article?              @relation("ImplementService", fields: [serviceArticleId], references: [id], onDelete: SetNull)

  @@index([serviceArticleId])
  @@index([tenantId])
  @@map("implements")
}

enum DeviceConnectivity {
  CELLULAR
  EYE_SENSOR
}

model TelemetryDevice {
  id               String             @id @default(cuid())
  tenantId         String             @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  connectivityType DeviceConnectivity @default(CELLULAR)
  imei             String?            @unique // Kohustuslik ainult CELLULAR seadmetel
  macAddress       String?            @unique // Kohustuslik ainult EYE_SENSOR seadmetel
  model            String
  simNumber        String?
  firmware         String?
  acquisitionDate  DateTime?          @db.Date // Soetamise kuupäev
  status           DeviceStatus       @default(OFFLINE)
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  createdBy        String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy        String? // viimase muutja kasutajatunnus (täidetakse automaatselt)

  assignments DeviceAssignment[]
  trips       VehicleTrip[]
  importState TripImportState?

  @@index([tenantId])
  @@map("telemetry_devices")
}

enum DeviceIdentifierKind {
  IMEI
  MAC
}

// Telemeetriaseadme omandiperiood: ettevõte näeb TimescaleDB andmeid ainult nende
// IMEI/MAC-ide ja ajavahemike kohta. Ilma välisvõtmeta seadmele — ajalugu säilib ka
// seadme kustutamisel või ümbernimetamisel.
model DeviceOwnership {
  id         String               @id @default(cuid())
  tenantId   String               @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  kind       DeviceIdentifierKind
  identifier String // IMEI (15 numbrit) või MAC (AA:BB:CC:DD:EE:FF)
  deviceId   String? // TelemetryDevice.id loomise hetkel (teave, mitte välisvõti)
  validFrom  DateTime             @default(now())
  validTo    DateTime? // null = kehtib
  createdAt  DateTime             @default(now())
  createdBy  String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy  String? // viimase muutja kasutajatunnus (täidetakse automaatselt)

  @@index([tenantId])
  @@index([kind, identifier])
  @@map("device_ownerships")
}

model DeviceAssignment {
  id            String          @id @default(cuid())
  tenantId      String          @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  deviceId      String
  device        TelemetryDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  vehicleId     String?
  vehicle       Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  implementId   String?
  implement     Implement?      @relation(fields: [implementId], references: [id], onDelete: SetNull)
  startedAt     DateTime        @default(now())
  endedAt       DateTime?
  lastLatitude  Float?
  lastLongitude Float?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt
  createdBy     String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy     String? // viimase muutja kasutajatunnus (täidetakse automaatselt)

  @@index([deviceId, startedAt])
  @@index([vehicleId, startedAt])
  @@index([tenantId])
  @@map("device_assignments")
}

enum TripStatus {
  ACTIVE
  CLOSED
}

// Sõit = seadme süüde sisse → välja (lühikesed pausid ≤ 10 min sees). Tuletatud telemeetriast taustaimpordiga;
// masin/haakeriist leitakse lugemisel seoste registrist (ei salvestata). Muudetav ainult märkus.
model VehicleTrip {
  id                String          @id @default(cuid())
  tenantId          String          @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  deviceId          String
  device            TelemetryDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  startedAt         DateTime
  endedAt           DateTime
  status            TripStatus
  startLat          Float
  startLng          Float
  startPlace        Json? // { place: PlaceRef | null, near?: TripNear }
  endLat            Float
  endLng            Float
  endPlace          Json?
  visits            Json? // TripVisit[]
  distanceKm        Float
  movingMinutes     Float
  idleMinutes       Float // seisuaeg süütega (tühikäik)
  pauseCount        Int
  pauseMinutes      Float
  maxSpeedKmh       Float?
  avgSpeedKmh       Float?
  fuelLiters        Float? // tühi = seade ei saada kütuseandmeid
  fuelLevelStartPct Float?
  fuelLevelEndPct   Float?
  engineHoursStart  Float?
  engineHoursEnd    Float?
  minLat            Float
  minLng            Float
  maxLat            Float
  maxLng            Float
  pointCount        Int
  areaHa            Float? // põldude kaetud pindala summa; tühi = ühelgi põllul pole haakeriista laiust
  notes             String?
  computedAt        DateTime
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdBy         String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy         String? // viimase muutja kasutajatunnus (täidetakse automaatselt)
  fields            VehicleTripField[]
  workEntries       WorkEntry[]

  @@index([deviceId, startedAt])
  @@index([tenantId, startedAt])
  @@map("vehicle_trips")
}

// Sõidu põllurida: sõidu osa ühel põllul (hooajal) — põllul oldud aeg, kaetud pindala ja kütus.
// Tuletatud impordis koos sõidu kohtadega; haakeriist on teave (mitte FK), et haakeriista kustutamisel ajalugu jääks.
model VehicleTripField {
  id            String      @id @default(cuid())
  tenantId      String      @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  tripId        String
  trip          VehicleTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fieldSeasonId Int
  fieldSeason   FieldSeason @relation(fields: [fieldSeasonId], references: [id], onDelete: Cascade)
  arriveAt      DateTime // esimene sõidu punkt põllu piires
  leaveAt       DateTime // viimane sõidu punkt põllu piires
  activeMinutes Float // põllul süütega oldud aeg (punktide vahed ≤ 5 min, pausid välja)
  areaHa        Float? // kaetud pindala põllu piires; tühi = haakeriista laius puudub
  implementId   String? // haakeriist, millega ha arvutati (teave, mitte FK)
  widthM        Float? // töölaius, millega ha arvutati
  fuelFieldL    Float? // põllul kulunud kütus
  fuelSharedL   Float? // põllu kütus + osa teekütusest (põllul oldud aja järgi)
  computedAt    DateTime

  @@unique([tripId, fieldSeasonId])
  @@index([fieldSeasonId, arriveAt])
  @@index([tenantId])
  @@map("vehicle_trip_fields")
}

// Seadme sõitude impordi olek: milleni on sõidud lõplikud, viimane käivitus ja viga, kohtade sõrmejälg.
model TripImportState {
  deviceId          String          @id
  device            TelemetryDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  tenantId          String          @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  finalizedUntil    DateTime?
  lastRunAt         DateTime?
  lastError         String?
  lastErrorAt       DateTime?
  placesFingerprint      String?
  placesCheckedAt        DateTime?
  assignmentsFingerprint String? // seoste (seade, haakimine, haakeriist) arv + viimane muutmisaeg
  assignmentsCheckedAt   DateTime?

  @@index([tenantId])
  @@map("trip_import_state")
}
model ImplementAssignment {
  id          String    @id @default(cuid())
  tenantId    String    @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  implementId String
  implement   Implement @relation(fields: [implementId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  createdBy   String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy   String? // viimase muutja kasutajatunnus (täidetakse automaatselt)

  @@index([vehicleId, startedAt])
  @@index([implementId, startedAt])
  @@index([tenantId])
  @@map("implement_assignments")
}

// ============================================================================
// 7. KULTUURID JA SORDID (CROPS & VARIETIES REGISTER)
// ============================================================================

enum CropGroup {
  CEREAL // Teravili (nisu, oder, kaer, rukis)
  OILSEED // Õlikultuur (raps, rüps)
  LEGUME // Kaunvili / Liblikõieline (hernes, uba)
  FORAGE_GRASS // Söödakultuur / Rohumaa (ristik, timut, karjamaa)
  FALLOW // Kesa (mustkesa, rohekesa)
  OTHER // Muu kultuur
}

enum Undersowing {
  NONE // allakülvita
  OTHER // allakülviga, v.a liblikõieliste allakülviga
  LEGUME // liblikõieliste allakülviga
}

model Crop {
  id                            String    @id
  tenantId                      String    @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  name                          String
  scientificName                String?
  group                         CropGroup @default(CEREAL)
  color                         String    @default("#eab308")
  icon                          String?
  priaCode                      String?
  defaultSeedRateKgHa           Float?
  defaultYieldTonsHa            Float?
  description                   String?
  isWinterCrop                  Boolean   @default(false) // Talivili: külvatakse sügisel (hooaeg algab eelmise aasta sügisel)
  // PRIA nimetus: hooaja PRIA kultuur tuletatakse neist (services/priaCropName.ts). Tühi = kultuuri nimi.
  priaName                      String? // PRIA nimetuse alus (nt "talinisu", "muu põlduba")
  priaUndersowing               Boolean   @default(false) // PRIA eristab allakülvi (nimele lisandub allakülvi variant)
  priaNameWithoutUndersowing    String? // erandnimi allakülvita variandile; tühi = alus + " allakülvita"
  priaNameWithUndersowing       String? // erandnimi muu allakülviga variandile
  priaNameWithLegumeUndersowing String? // erandnimi liblikõieliste allakülviga variandile
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt
  createdBy                     String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy                     String? // viimase muutja kasutajatunnus (täidetakse automaatselt)

  varieties     CropVariety[]
  fieldSeasons  FieldSeason[]
  workTemplates WorkTemplate[]
  articles      Article[]
  harvestLots   HarvestLot[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("crops")
}

model CropVariety {
  id                      String   @id
  tenantId                String   @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  cropId                  String
  name                    String
  breeder                 String? // Aretaja / esindaja (nt Saaten-Union, KWS)
  maturityDays            String? // Valmimisaeg / kasvuaeg
  winterHardiness         String? // Talvekindlus
  recommendedSeedRateKgHa Float? // Soovituslik külvinorm kg/ha
  potentialYieldTonsHa    Float? // Saagipotentsiaal t/ha
  qualityClass            String? // Kvaliteediklass (nt Toiduvili E, I, söödavili)
  priaName                String? // PRIA nimetuse alus, kui PRIA eristab sorti (nt '"Sangaste" rukis'); tühi = kultuuri oma
  notes                   String?
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  createdBy               String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy               String? // viimase muutja kasutajatunnus (täidetakse automaatselt)

  crop         Crop          @relation(fields: [cropId], references: [id], onDelete: Cascade)
  fieldSeasons FieldSeason[]

  articles Article[]

  @@unique([cropId, name])
  @@index([cropId])
  @@index([tenantId])
  @@map("crop_varieties")
}

// ============================================================================
// 8. MULLAPROOVID (SOIL SAMPLES)
// ============================================================================

model SoilSample {
  id              Int      @id @default(autoincrement())
  tenantId        String   @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  sampleNumber    String // Labori proovinumber ("proovNr") - kordusimpordil kasutatav võti
  fieldCode       String // PRIA massiivi number ("xy_id") - tekstivõrdlusega seotud Field.fieldCode'iga, mitte range FK (massiiv võib kuuluda mitmele Field kirjele)
  year            Int // Proovivõtu aasta ("aasta")
  lat             Float
  lng             Float
  ph              Float?
  phosphorus      Float? // Fosfor (P)
  potassium       Float? // Kaalium (K)
  calcium         Float? // Kaltsium (Ca)
  magnesium       Float? // Magneesium (Mg)
  copper          Float? // Vask (Cu)
  manganese       Float? // Mangaan (Mn)
  boron           Float? // Boor (B)
  organicCarbon   Float? // Orgaanilise süsiniku sisaldus (Corg)
  limeRequirement Float? // Lubjatarve t/ha
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy       String? // viimase muutja kasutajatunnus (täidetakse automaatselt)

  @@unique([tenantId, sampleNumber])
  @@index([fieldCode])
  @@index([year])
  @@index([tenantId])
  @@map("soil_samples")
}

// ============================================================================
// 9b. PÕLLUTÖÖDE REGISTER (PRIA põlluraamatust lahus)
// Tööde register → mallid (üldmall + kultuuri mall) → hooaja põllu tööd →
// kanded (tööpäevad, töötaja sisestab kogused) → read (finantsjuht lisab ühiku kulu).
// ============================================================================

enum WorkPhase {
  PREPARATION // ettevalmistus
  SOWING // külv
  CARE // hooldus
  HARVEST // koristus
}

enum WorkRepeatMode {
  ONCE // ühekordne
  UP_TO // kuni maxRepeats korda
  INTERVAL // iga intervalDays päeva järel
}

enum FieldWorkStatus {
  PLANNED
  IN_PROGRESS
  DONE
}

enum WorkEntryLineKind {
  LABOR // tööaeg (h)
  MACHINE // masin (h)
  IMPLEMENT // haakeriist (h, sama mis masinal)
  FUEL // kütus (l)
  MATERIAL // kulumaterjal
  HARVEST // saak (t) — tulu
  OBSERVATION // seire leid (ei osale finantsis)
}

enum FinanceStatus {
  PENDING // ootab finantsjuhti
  CONFIRMED // kinnitatud
  CHANGED // kogust muudeti pärast kinnitamist — kinnita uuesti
}

enum WorkSource {
  MANUAL // Terises loodud (käsitsi või mallist)
  PRIA_IMPORT // PRIA põlluraamatu väljavõtte impordist
}

enum ArticleGroup {
  SERVICE // teenus — laoarvestust pole
  CONSUMABLE // kulumaterjal
  PRODUCE // toodang
  OTHER_GOODS // muu kaup
}

// Süsteemne liik: loogika käitub selle järgi (src/services/articleRules.ts). Kasutaja loodud liigil null.
enum ArticleSystemKind {
  LABOR_TIME // töötaja tööaeg
  MACHINE_TIME // masina tööaeg
  IMPLEMENT_TIME // haakeriista tööaeg
  DRYING_TIME // kuivatamise tööaeg
  SEED // seeme: sort, PRIA
  FERTILIZER // väetis: NPK, PRIA
  PLANT_PROTECTION // taimekaitsevahend: toimeaine, PRIA
  FUEL // kütus
  DRYING_OIL // kuivatusõli
  GRAIN // terad: kultuur
  BUNKERS // punkrid: kultuur; koristatud ja kaalumata vili punkrites
}

// Artikli liik; süsteemsed liigid luuakse automaatselt (src/server/articleCategories.ts)
model ArticleCategory {
  id         String             @id @default(cuid())
  tenantId   String             @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  name       String
  group      ArticleGroup
  systemKind ArticleSystemKind? // süsteemne liik; ei saa kustutada ega teise rühma viia
  sortOrder  Int                @default(0)
  isActive   Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  createdBy  String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy  String? // viimase muutja kasutajatunnus (täidetakse automaatselt)

  articles Article[]

  @@unique([tenantId, name])
  @@unique([tenantId, systemKind])
  @@index([tenantId])
  @@map("article_categories")
}

model WorkType {
  id            String         @id @default(cuid())
  tenantId      String         @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  name          String
  phase         WorkPhase
  repeatMode    WorkRepeatMode @default(ONCE)
  maxRepeats    Int?
  intervalDays  Int?
  usesMaterials Boolean        @default(false) // kandes küsitakse kulumaterjale
  priaCode      String? // PRIA e-põlluraamatu tegevus, nt "Taimekaitsevahendi kasutamine"
  shortName     String? // ettevõtte lühinimi; kui täidetud, kuvatakse tööde ja põllu vaates PRIA nime asemel
  sortOrder     Int            @default(0)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  createdBy     String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy     String? // viimase muutja kasutajatunnus (täidetakse automaatselt)

  templateItems WorkTemplateItem[]
  fieldWorks    FieldWork[]

  @@unique([tenantId, name])
  @@unique([tenantId, priaCode])
  @@index([tenantId])
  @@map("work_types")
}

// Artikkel (kulumaterjal, hiljem ka teenus ja toodang)
model Article {
  id                 String   @id @default(cuid())
  tenantId           String   @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  name               String
  categoryId         String // liik
  unit               String // kg, l, t, tk
  manufacturer       String? // tootja (vaba tekst; vormis pakutakse olemasolevaid)
  composition        String? // koostisosad (toimeained, toitained jms; vaba tekst)
  cropVarietyId      String? // seemne puhul sort
  price              Decimal? @db.Decimal(12, 4) // ainult teenusel: ühiku (tunni) hind
  cropId             String? // ainult terade liigil: kultuur
  defaultWarehouseId String? // ainult kaubal: vaikimisi ladu
  isDefaultService   Boolean  @default(false) // tööaja liigi vaikimisi teenus; liigi kohta üks, tagab rakendus (src/server/entryArticles.ts)
  // PRIA vaikeväärtused: täidavad plaani/kande rea materjali valimisel
  priaRegister       String? // "Väetis registrist", "EL ühtne sordileht", ...
  priaKind           String? // liik ("Taliraps", "NPK väetis", "Herbitsiid")
  priaSpec           String? // seemne kategooria ("C2")
  activeIngredient   String? // taimekaitsevahendi toimeaine
  nPct               Float? // väetise N sisaldus %; rea N kg/ha = kogus/ha × % / 100
  pPct               Float?
  kPct               Float?
  aliases            String[] @default([]) // asendatud materjalide nimed (nameKey kujul); PRIA import seob need selle materjaliga
  isActive           Boolean  @default(true)
  notes              String?
  stockIssueCount    Int      @default(0) // põllutöö kanderead, mida ei saa laoühikusse teisendada (arvestusest väljas)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdBy          String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy          String? // viimase muutja kasutajatunnus (täidetakse automaatselt)

  cropVariety       CropVariety?        @relation(fields: [cropVarietyId], references: [id], onDelete: SetNull)
  category          ArticleCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  crop              Crop?               @relation(fields: [cropId], references: [id], onDelete: SetNull)
  defaultWarehouse  Warehouse?          @relation("ArticleDefaultWarehouse", fields: [defaultWarehouseId], references: [id], onDelete: SetNull)
  entryLines        WorkEntryLine[]
  fieldWorkLines    FieldWorkLine[]
  stockLines        StockDocumentLine[]
  stock             ArticleStock[]
  harvestLots       HarvestLot[]        @relation("HarvestLotArticle")
  harvestLotCosts   HarvestLotCost[]    @relation("HarvestLotCostArticle")
  vehicleServices   Vehicle[]           @relation("VehicleService")
  vehicleFuels      Vehicle[]           @relation("VehicleFuel")
  implementServices Implement[]         @relation("ImplementService")
  partyServices     RelatedParty[]      @relation("PartyService")

  @@unique([tenantId, categoryId, name])
  @@index([categoryId])
  @@index([cropId])
  @@index([defaultWarehouseId])
  @@index([cropVarietyId])
  @@index([tenantId])
  @@map("articles")
}

// cropId = null → üldmall (isWinter = false → Kevadkülvi mall, isWinter = true → Sügiskülvi mall)
model WorkTemplate {
  id        String   @id @default(cuid())
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  cropId    String?
  isWinter  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy String? // viimase muutja kasutajatunnus (täidetakse automaatselt)

  crop  Crop?              @relation(fields: [cropId], references: [id], onDelete: Cascade)
  items WorkTemplateItem[]

  @@unique([tenantId, cropId, isWinter])
  @@index([tenantId])
  @@map("work_templates")
}

model WorkTemplateItem {
  id            String  @id @default(cuid())
  tenantId      String  @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  templateId    String
  workTypeId    String
  sortOrder     Int     @default(0)
  plannedCount  Int? // korduva töö plaanitud kordi (tühi = töö liigi järgi)

  template WorkTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  workType WorkType     @relation(fields: [workTypeId], references: [id], onDelete: Restrict)

  @@unique([templateId, workTypeId])
  @@index([workTypeId])
  @@index([tenantId])
  @@map("work_template_items")
}

// Hooaja põllu töö (kopeeritakse mallist kultuuri valimisel; lisatav/eemaldatav)
model FieldWork {
  id              String          @id @default(cuid())
  tenantId        String          @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  fieldSeasonId   Int
  workTypeId      String
  phase           WorkPhase
  sortOrder       Int             @default(0)
  plannedText     String? // nt "okt 2026"
  plannedCount    Int             @default(1)
  status          FieldWorkStatus @default(PLANNED)
  finishedAt      DateTime?
  finishedById    String?
  fromTemplate    Boolean         @default(false)
  notes           String?
  plannedDateFrom DateTime? // planeeritud algus (PRIA "Kuupäev")
  plannedDateTo   DateTime? // planeeritud lõpp; tühi = üks päev
  plannedAreaHa   Float? // planeeritud pindala; tühi = põllu pindala
  method          String? // väetamisviis jms: "Paisklaotamine", "Pritsimine"
  plannedWorkerId String? // planeeritud teostaja (taimekaitse)
  source          WorkSource      @default(MANUAL)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdBy       String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy       String? // viimase muutja kasutajatunnus (täidetakse automaatselt)

  fieldSeason   FieldSeason     @relation(fields: [fieldSeasonId], references: [id], onDelete: Cascade)
  workType      WorkType        @relation(fields: [workTypeId], references: [id], onDelete: Restrict)
  finishedBy    User?           @relation("FieldWorkFinishedBy", fields: [finishedById], references: [id], onDelete: SetNull)
  entries       WorkEntry[]
  plannedWorker RelatedParty?   @relation("FieldWorkPlannedWorker", fields: [plannedWorkerId], references: [id], onDelete: SetNull)
  lines         FieldWorkLine[]

  @@index([fieldSeasonId, workTypeId]) // sama tüüpi töid võib põllul olla mitu
  @@index([plannedWorkerId])
  @@index([workTypeId])
  @@index([tenantId])
  @@map("field_works")
}

// Töö plaani rida: planeeritud materjal (norm ha kohta) või saak
model FieldWorkLine {
  id               String            @id @default(cuid())
  tenantId         String            @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  fieldWorkId      String
  kind             WorkEntryLineKind // MATERIAL | HARVEST
  articleId        String?
  label            String
  ratePerHa        Float? // kogus ha kohta
  unit             String // kg, l, t, g, tk
  priaRegister     String? // "Väetis registrist", "Eesti sordiregister", "Märgaja/kleepaine", ...
  priaKind         String? // "Herbitsiid", "NPK väetis", "Suvinisu"; saagil saagi tüüp ("Terad")
  priaSpec         String? // seemne kategooria ("C1"); saagil kultuuri tüüp ("Põhikultuur")
  activeIngredient String? // toimeaine
  nKgHa            Float?
  pKgHa            Float?
  kKgHa            Float?
  sortOrder        Int               @default(0)

  fieldWork FieldWork @relation(fields: [fieldWorkId], references: [id], onDelete: Cascade)
  article   Article?  @relation(fields: [articleId], references: [id], onDelete: Restrict)

  @@index([fieldWorkId])
  @@index([articleId])
  @@index([tenantId])
  @@map("field_work_lines")
}

// Kanne = üks tööpäev/tööosa; töötaja sisestab ainult kogused
model WorkEntry {
  id                   String        @id @default(cuid())
  tenantId             String        @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  fieldWorkId          String
  date                 DateTime
  workerId             String? // seotud isik (roll Töötaja)
  areaHa               Float?
  telemetryAreaHa      Float? // Telemeetriast (GPS) arvutatud tehtud pindala (ha)
  occurrenceNo         Int? // korduva töö mitmes kord
  vehicleId            String?
  implementId          String?
  equipmentHours       Float? // masina ja haakeriista töötunnid (sisestatakse korraga)
  fuelLiters           Float?
  laborHours           Float?
  startTime            String? // alguskellaaeg (nt "08:00")
  endTime              String? // lõpukellaaeg (nt "16:30")
  notes                String?
  dateTo               DateTime? // vahemiku lõpp (PRIA "27.04.2026 - 30.04.2026"); tühi = üks päev
  method               String? // tegelik viis (väetamisviis jms)
  harvestBunkers       Float? // saagikoristusel punkrite arv; PRIA impordist ei tule, alus tonnide arvutamiseks
  harvestLotId         String? // saagipartii (koristuskanne); PRIA impordil tühi
  harvestTonnesManual  Boolean       @default(false) // saagi tonnid käsitsi lukustatud, punkri kaalu jaotusest väljas
  warehouseId          String? // ladu, kust kande materjalid võetakse; tühi = põhiladu
  tripId               String? // sõitude registri sõit, millest kanne tehti; tühi = seoseta
  source               WorkSource    @default(MANUAL)
  createdById          String?
  financeStatus        FinanceStatus @default(PENDING)
  financeConfirmedAt   DateTime?
  financeConfirmedById String?
  financeNotes         String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  createdBy            String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy            String? // viimase muutja kasutajatunnus (täidetakse automaatselt)

  fieldWork          FieldWork       @relation(fields: [fieldWorkId], references: [id], onDelete: Cascade)
  worker             RelatedParty?   @relation(fields: [workerId], references: [id], onDelete: SetNull)
  vehicle            Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  implement          Implement?      @relation(fields: [implementId], references: [id], onDelete: SetNull)
  warehouse          Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdByUser      User?           @relation("WorkEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  financeConfirmedBy User?           @relation("WorkEntryConfirmedBy", fields: [financeConfirmedById], references: [id], onDelete: SetNull)
  harvestLot         HarvestLot?     @relation(fields: [harvestLotId], references: [id], onDelete: SetNull)
  trip               VehicleTrip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  lines              WorkEntryLine[]

  @@index([fieldWorkId])
  @@index([harvestLotId])
  @@index([tripId])
  @@index([financeStatus])
  @@index([workerId])
  @@index([warehouseId])
  @@index([tenantId])
  @@map("work_entries")
}

// Kande finantsrida: kogus töötajalt, ühiku kulu/hind finantsjuhilt (ERP-st käsitsi)
model WorkEntryLine {
  id                String            @id @default(cuid())
  tenantId          String            @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  entryId           String
  kind              WorkEntryLineKind
  vehicleId         String?
  implementId       String?
  articleId         String?
  label             String // nimi salvestamise hetkel
  quantity          Float
  unit              String
  unitPrice         Decimal?          @db.Decimal(12, 4)
  confirmedQuantity Float? // kogus viimasel kinnitamisel (muudatuse näitamiseks)
  ratePerHa         Float? // kogus ha kohta
  priaRegister      String? // vt FieldWorkLine; seirel seire liik ("Umbrohud")
  priaKind          String?
  priaSpec          String?
  activeIngredient  String?
  nKgHa             Float?
  pKgHa             Float?
  kKgHa             Float?
  sortOrder         Int               @default(0)

  entry     WorkEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  vehicle   Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  implement Implement? @relation(fields: [implementId], references: [id], onDelete: SetNull)
  article   Article?   @relation(fields: [articleId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([articleId])
  @@index([tenantId])
  @@map("work_entry_lines")
}

// ============================================================================
// 9b. LAOARVESTUS
// Laod → laokanded (arvele võtmine, mahakandmine, ülekanne, inventuur) + põllutöö kande materjali- ja kütuseread.
// Laoseis ja FIFO hinnad arvutatakse liikumistest (src/server/stock.ts); article_stock on koond.
// ============================================================================

enum StockDocumentKind {
  RECEIPT // arvele võtmine
  WRITE_OFF // mahakandmine
  TRANSFER // ladudevaheline ülekanne
  INVENTORY // inventuur: tegelik seis, vahe arvutab ümberarvutus
}

enum WriteOffReason {
  SPOILED // riknenud
  INVENTORY // inventuuri vahe (ainult vanadel kannetel; uutele ei pakuta)
  SOLD // müük
  OTHER // muu (täpsustus märkuses)
}

// Ladu; ettevõttel täpselt üks põhiladu (isDefault), tagab rakendus (src/server/stock.ts)
model Warehouse {
  id        String   @id @default(cuid())
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  name      String
  isDefault Boolean  @default(false) // põhiladu: põllutöö kanded vaikimisi, PRIA import
  isActive  Boolean  @default(true)
  poiId     String?  @unique // asukoht kaardil (huvipunkt)
  fieldId   Int?     @unique // põllu ladu: koristuskanded võtavad punkrid siia arvele
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy String? // viimase muutja kasutajatunnus (täidetakse automaatselt)

  poi           PointOfInterest? @relation(fields: [poiId], references: [id], onDelete: SetNull)
  field         Field?           @relation(fields: [fieldId], references: [id], onDelete: SetNull) // põllu kustutamisel jääb tavaliseks laoks
  documentsFrom StockDocument[]  @relation("StockDocFrom")
  documentsTo   StockDocument[]  @relation("StockDocTo")
  entries       WorkEntry[]
  stock         ArticleStock[]
  defaultFor    Article[]        @relation("ArticleDefaultWarehouse")
  harvestLots   HarvestLot[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("warehouses")
}

// Laokanne: arvele võtmine, mahakandmine, ülekanne või inventuur
model StockDocument {
  id             String            @id @default(cuid())
  tenantId       String            @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  kind           StockDocumentKind
  date           DateTime
  warehouseId    String // RECEIPT: sihtladu; WRITE_OFF ja TRANSFER: lähteladu; INVENTORY: inventeeritav ladu
  toWarehouseId  String? // ainult TRANSFER: sihtladu
  supplierId     String? // ainult RECEIPT: seotud isik rolliga Tarnija
  documentNo     String? // arve / saatelehe number
  writeOffReason WriteOffReason? // ainult WRITE_OFF
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdBy      String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy      String? // viimase muutja kasutajatunnus (täidetakse automaatselt)

  warehouse   Warehouse           @relation("StockDocFrom", fields: [warehouseId], references: [id], onDelete: Restrict)
  toWarehouse Warehouse?          @relation("StockDocTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  supplier    RelatedParty?       @relation("StockDocSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  lines       StockDocumentLine[]

  @@index([date])
  @@index([warehouseId])
  @@index([toWarehouseId])
  @@index([supplierId])
  @@index([tenantId])
  @@map("stock_documents")
}

model StockDocumentLine {
  id          String   @id @default(cuid())
  tenantId    String   @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  documentId  String
  articleId   String
  quantity    Float // laoühikus, > 0; INVENTORY: |diffQty| (kirjutab ümberarvutus)
  amount      Decimal? @db.Decimal(12, 2) // RECEIPT: rea summa km-ta; INVENTORY: ülejäägi väärtus
  fifoCost    Decimal? @db.Decimal(12, 2) // WRITE_OFF, TRANSFER, INVENTORY puudujääk: arvutatud maksumus; null = (osaliselt) hindamata
  shortageQty Float? // TRANSFER: kogus, mida lähtelaos hinnaga kaubana polnud (probleem)
  countedQty  Float? // INVENTORY: tegelik seis; 0 = kõik maha
  diffQty     Float? // INVENTORY: arvutatud vahe (+ juurde, − maha); kirjutab ümberarvutus
  sortOrder   Int      @default(0)

  document StockDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  article  Article       @relation(fields: [articleId], references: [id], onDelete: Restrict)

  @@index([documentId])
  @@index([articleId])
  @@index([tenantId])
  @@map("stock_document_lines")
}

// Laoseisu koond artikli ja lao kaupa; kirjutab ainult ümberarvutus
model ArticleStock {
  tenantId    String  @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  articleId   String
  warehouseId String
  qty         Float   @default(0) // võib olla negatiivne
  value       Decimal @default(0) @db.Decimal(12, 2) // hinnatud partiide jääk
  unpricedQty Float   @default(0) // hindamata kogus (võlg või hindamata partii)
  pricedQty   Float   @default(0) // hinnatud partiide kogus (keskmise hinna jagaja)

  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([articleId, warehouseId])
  @@index([warehouseId])
  @@index([tenantId])
  @@map("article_stock")
}

// ============================================================================
// 9c. SAAGIPARTIID
// Koristuskanded → partii; kaalumised võtavad toodangu lattu (hinnata); sulgemisel arvutatakse punkri kaal
// ja kannete tonnid (src/server/harvestLots.ts); kuivatuskulud jaotatakse põldudele lugemisel.
// ============================================================================

enum HarvestLotStatus {
  OPEN // lahtine: kandeid ja kaalumisi saab lisada
  CLOSED // suletud: punkri kaal arvutatud
}

model HarvestLot {
  id           String           @id @default(cuid())
  tenantId     String           @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  name         String // "Talinisu 2026"
  seasonId     Int
  cropId       String
  articleId    String // toodanguartikkel (liik GRAIN)
  warehouseId  String // hoidla
  status       HarvestLotStatus @default(OPEN)
  bunkerTonnes Float? // arvutatud punkri kaal; täitub sulgemisel
  closedAt     DateTime?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  createdBy    String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy    String? // viimase muutja kasutajatunnus (täidetakse automaatselt)

  season    Season               @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  crop      Crop                 @relation(fields: [cropId], references: [id], onDelete: Restrict)
  article   Article              @relation("HarvestLotArticle", fields: [articleId], references: [id], onDelete: Restrict)
  warehouse Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  entries   WorkEntry[]
  weighings HarvestLotWeighing[]
  costs     HarvestLotCost[]

  @@unique([tenantId, name])
  @@index([seasonId])
  @@index([cropId])
  @@index([articleId])
  @@index([warehouseId])
  @@index([tenantId])
  @@map("harvest_lots")
}

// Kaalumine = toodangu arvelevõtt partii hoidlasse (hinnata)
model HarvestLotWeighing {
  id        String   @id @default(cuid())
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  lotId     String
  date      DateTime
  tonnes    Float
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy String? // viimase muutja kasutajatunnus (täidetakse automaatselt)

  lot HarvestLot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([lotId])
  @@index([tenantId])
  @@map("harvest_lot_weighings")
}

// Kuivatuskulu: teenus (tunnid, hind artiklist) või kaup (laost maha FIFO-ga)
model HarvestLotCost {
  id        String   @id @default(cuid())
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  lotId     String
  date      DateTime
  articleId String
  quantity  Float // artikli ühikus
  unitPrice Decimal? @db.Decimal(12, 4) // teenusel artiklist, kaubal FIFO (kirjutab ümberarvutus)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy String? // viimase muutja kasutajatunnus (täidetakse automaatselt)

  lot     HarvestLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  article Article    @relation("HarvestLotCostArticle", fields: [articleId], references: [id], onDelete: Restrict)

  @@index([lotId])
  @@index([articleId])
  @@index([tenantId])
  @@map("harvest_lot_costs")
}

// ============================================================================
// 10. KASUTAJAD JA SESSIOONID (rakenduse sisselogimine)
// ============================================================================

model User {
  id                 String    @id @default(cuid())
  tenantId           String    @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  username           String    @unique // väiketähtedega
  passwordHash       String
  displayName        String?
  email              String?   @unique
  isActive           Boolean   @default(true)
  isAdmin            Boolean   @default(false)
  mustChangePassword Boolean   @default(false)
  isFinanceManager   Boolean   @default(false) // finantsjuht: kannete ühiku kulud, kinnitamine, põldude tulemus
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdBy          String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy          String? // viimase muutja kasutajatunnus (täidetakse automaatselt)

  sessions             Session[]
  apiKeys              ApiKey[]
  passwordTokens       PasswordToken[]
  finishedFieldWorks   FieldWork[]     @relation("FieldWorkFinishedBy")
  createdWorkEntries   WorkEntry[]     @relation("WorkEntryCreatedBy")
  confirmedWorkEntries WorkEntry[]     @relation("WorkEntryConfirmedBy")
  supportGrants        SupportGrant[]  @relation("SupportGrantGrantedBy")

  @@index([tenantId])
  @@map("users")
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique // SHA-256 küpsise tokenist
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Kasutaja isiklik API-võti AI ühenduse (MCP) jaoks; võtit ennast ei salvestata (platvormi tabel nagu sessions)
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String // kasutaja antud nimi (nt "Claude Desktop sülearvutis")
  keyHash    String    @unique // SHA-256 võtmest
  keyPrefix  String // võtme algus äratundmiseks (nt "trs_ab12cd")
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

// Ettevõtte admini antud ajutine luba kasutajatoele (ainult lugemiseks)
model SupportGrant {
  id              String    @id @default(cuid())
  tenantId        String    @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  grantedByUserId String
  validUntil      DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  createdBy       String? // looja kasutajatunnus (täidetakse automaatselt)
  updatedBy       String? // viimase muutja kasutajatunnus (täidetakse automaatselt)

  grantedBy User               @relation("SupportGrantGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Cascade)
  accesses  SupportAccessLog[]

  @@index([tenantId])
  @@map("support_grants")
}

// Kasutajatoe sisenemine ettevõtte keskkonda (ettevõtte adminile nähtav)
model SupportAccessLog {
  id               String   @id @default(cuid())
  tenantId         String   @default(dbgenerated("current_setting('app.tenant_id')")) @map("tenant_id") // Ettevõte; täitub päringu kontekstist
  supportGrantId   String
  platformUsername String // teenusepakkuja kasutajanimi sisenemise hetkel
  startedAt        DateTime @default(now())

  grant SupportGrant @relation(fields: [supportGrantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("support_access_log")
}

model PasswordToken {
  id        Int       @id @default(autoincrement())
  userId    String
  purpose   String // 'INVITE' | 'RESET'
  tokenHash String    @unique // SHA-256 toortokenist (toortoken ainult e-kirjas)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_tokens")
}

// ============================================================================
// ETTEVÕTTED (TENANTS)
// ============================================================================
enum TenantStatus {
  ACTIVE
  SUSPENDED
}

model Tenant {
  id             String       @id @default(cuid())
  name           String
  registryCode   String?
  status         TenantStatus @default(ACTIVE)
  primaryPartyId String? // Ettevõte ise seotud isikute registris (roll OPERATOR) — tema keskkonnas
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("tenants")
}

// ============================================================================
// ETTEVÕTTE LITSENTS
// ============================================================================
enum LicenseModule {
  TELEMETRY
  SATELLITE
  WEATHER
}

// Ettevõtte litsents — teenusepakkuja andmed (ilma RLS-ita, loetakse authDb() kaudu)
model TenantLicense {
  id         String          @id @default(cuid())
  tenantId   String          @unique
  validUntil DateTime        @db.Date // Viimane kehtiv päev (Europe/Tallinn)
  modules    LicenseModule[] // Litsentsitud lisamoodulid; põhimoodul on alati sees
  updatedAt  DateTime        @updatedAt
  updatedBy  String? // Kes viimati muutis (teenusepakkuja kasutaja või "cli")

  @@map("tenant_licenses")
}

// ============================================================================
// TEENUSEPAKKUJA (PLATVORM) — loetakse ainult authDb() kaudu, teris_app ei näe
// ============================================================================
model PlatformUser {
  id            String    @id @default(cuid())
  username      String    @unique // väiketähtedega
  passwordHash  String
  totpSecretEnc String // AES-256-GCM krüpteeritud base32 saladus (PLATFORM_TOTP_KEY)
  totpLastStep  Int       @default(0) // viimati aktsepteeritud TOTP samm (korduskasutuse vastu)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions PlatformSession[]

  @@map("platform_users")
}

model PlatformSession {
  id             String   @id @default(cuid())
  platformUserId String
  tokenHash      String   @unique // SHA-256 küpsise tokenist
  expiresAt      DateTime
  userAgent      String?
  createdAt      DateTime @default(now())

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId])
  @@map("platform_sessions")
}

model PlatformAuditLog {
  id             String   @id @default(cuid())
  platformUserId String? // null = käsurida
  action         String // nt TENANT_CREATE, LICENSE_UPDATE, TENANT_SUSPEND, TENANT_ACTIVATE, INVITE_RESEND, LOGIN
  targetTenantId String? // mitte "tenantId" — muidu satuks mudel TENANT_MODELS-i
  details        Json?
  createdAt      DateTime @default(now())

  @@index([targetTenantId])
  @@index([createdAt])
  @@map("platform_audit_log")
}

// Platvormi tabel (authDb): ühekordne üleandmistoken ja tugisessioon
model SupportSession {
  id               String    @id @default(cuid())
  targetTenantId   String // mitte "tenantId" — muidu satuks mudel TENANT_MODELS-i
  supportGrantId   String
  platformUserId   String
  handoffTokenHash String?   @unique // kustutatakse (null) pärast vahetamist
  handoffExpiresAt DateTime
  sessionTokenHash String?   @unique // tekib vahetamisel
  expiresAt        DateTime? // tugisessiooni lõpp
  createdAt        DateTime  @default(now())

  @@index([supportGrantId])
  @@map("support_sessions")
}

// Platvormi tabel (authDb): kasutajajuhendid; võtmed on koodis (src/help/helpRegistry.ts)
model HelpArticle {
  key       String   @id
  html      String
  updatedBy String? // platvormi kasutajanimi
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("help_articles")
}

// Platvormi tekstiseaded, mida teenusepakkuja muudab admin.teris.ee-s (nt AI juhis)
model PlatformSetting {
  key       String   @id // nt "mcp_instructions"
  value     String
  updatedBy String? // platvormi kasutajanimi
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("platform_settings")
}

// ============================================================================
// ALGKATALOOG — teenusepakkuja hallatav; kopeeritakse uuele ettevõttele loomisel
// (platvormi tabelid: ainult authDb(), teris_app ei näe)
// ============================================================================
model CatalogCrop {
  id                  String    @id @default(cuid())
  name                String    @unique
  scientificName      String?
  group               CropGroup @default(CEREAL)
  color               String    @default("#eab308")
  icon                String?
  priaCode            String?
  defaultSeedRateKgHa Float?
  defaultYieldTonsHa  Float?
  description         String?
  isWinterCrop        Boolean   @default(false)
  priaName            String? // PRIA nimetuse alus
  priaUndersowing     Boolean   @default(false) // PRIA eristab allakülvi
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  varieties CatalogCropVariety[]
  templates CatalogWorkTemplate[]

  @@map("catalog_crops")
}

model CatalogCropVariety {
  id                      String  @id @default(cuid())
  catalogCropId           String
  name                    String
  breeder                 String?
  maturityDays            String?
  winterHardiness         String?
  recommendedSeedRateKgHa Float?
  potentialYieldTonsHa    Float?
  qualityClass            String?
  notes                   String?
  isActive                Boolean @default(true)

  crop CatalogCrop @relation(fields: [catalogCropId], references: [id], onDelete: Cascade)

  @@unique([catalogCropId, name])
  @@map("catalog_crop_varieties")
}

model CatalogWorkType {
  id            String         @id @default(cuid())
  name          String         @unique
  phase         WorkPhase
  repeatMode    WorkRepeatMode @default(ONCE)
  maxRepeats    Int?
  intervalDays  Int?
  usesMaterials Boolean        @default(false)
  priaCode      String?        @unique // PRIA e-põlluraamatu tegevus
  sortOrder     Int            @default(0)
  isActive      Boolean        @default(true)

  templateItems CatalogWorkTemplateItem[]

  @@map("catalog_work_types")
}

model CatalogWorkTemplate {
  id            String  @id @default(cuid())
  catalogCropId String? // null = üldmall (suvi/tali)
  isWinter      Boolean @default(false)

  crop  CatalogCrop?              @relation(fields: [catalogCropId], references: [id], onDelete: Cascade)
  items CatalogWorkTemplateItem[]

  // NB: NULL catalogCropId korral Postgres ei pea ridu duplikaatideks — üldmallide unikaalsust kontrollib API (Task 5)
  @@unique([catalogCropId, isWinter])
  @@map("catalog_work_templates")
}

model CatalogWorkTemplateItem {
  id                String  @id @default(cuid())
  templateId        String
  catalogWorkTypeId String
  sortOrder         Int     @default(0)
  plannedCount      Int?

  template CatalogWorkTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  workType CatalogWorkType     @relation(fields: [catalogWorkTypeId], references: [id], onDelete: Restrict)

  @@unique([templateId, catalogWorkTypeId])
  @@map("catalog_work_template_items")
}

// ============================================================================
// LANDING-LEHT — platvormi tabelid (ilma RLS-ita, ainult authDb())
// ============================================================================

// Landing'u külastuste mõõtmine. IP-d ei salvestata; visitorHash vahetub iga päev.
model LandingEvent {
  id           BigInt   @id @default(autoincrement())
  ts           DateTime @default(now())
  source       String // 'server' | 'beacon'
  event        String // 'hit' | 'view' | 'cta_click' | 'form_submit'
  target       String? // cta_click nupu tunnus
  path         String
  visitorClass String // 'human' | 'ai_bot' | 'search_bot' | 'other_bot'
  botName      String?
  referrerHost String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  device       String // 'desktop' | 'mobile' | 'tablet'
  visitorHash  String   @db.Char(16)

  @@index([ts])
  @@map("landing_events")
}

enum InterestStatus {
  NEW
  CONTACTED
  CLOSED
}

// „Tunnen huvi“ vormi päringud. IP-d ei salvestata.
model InterestRequest {
  id           String         @id @default(cuid())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  name         String
  email        String
  company      String?
  phone        String?
  areaHa       Float?
  message      String?
  status       InterestStatus @default(NEW)
  notes        String?
  closedAt     DateTime?
  utmSource    String?
  referrerHost String?

  @@index([status])
  @@map("interest_requests")
}

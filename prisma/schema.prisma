// prisma/schema.prisma
// Loisu / AgriMap Pro - Prisma andmebaasi skeem

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// ENUMS
// ============================================================================

enum SeasonStatus {
  PLANNING
  ACTIVE
  HARVESTING
  CLOSED
}

enum FieldStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum PoiCategory {
  DRYER
  WATER_SOURCE
  WORKSHOP
  FUEL_STATION
  FIELD_ENTRANCE
  STORAGE
  SCALE
  OTHER
}

enum VehicleType {
  TRACTOR
  COMBINE
  SPRAYER
  SPREADER
  TRUCK
  ATV
  LOADER
}

enum ImplementType {
  CULTIVATOR
  SEEDER
  SPRAYER
  HEADER
  DISC_HARROW
  PLOW
  MOWER
  TRAILER
  FERTILIZER_SPREADER
  ROLLER
  OTHER
}

enum DeviceStatus {
  WORKING
  MOVING
  STOPPED
  IDLING
  OFFLINE
}

enum OwnershipType {
  OWNED
  RENTED
}

enum PartyType {
  PERSON
  LEGAL_ENTITY
}

enum PartyRole {
  LANDOWNER
  DRIVER    // kuvatakse "Töötaja"
  OPERATOR
  OTHER     // "Muu seotud isik" (täpsustus märkustes)
}

// ============================================================================
// 1. HOOAJAD (SEASONS)
// ============================================================================

model Season {
  id                   Int           @id @default(autoincrement())
  year                 Int           @unique
  name                 String
  status               SeasonStatus  @default(PLANNING)
  isLocked             Boolean       @default(false)
  preparationStartDate DateTime?
  seedingStartDate     DateTime?
  harvestStartDate     DateTime?
  harvestEndDate       DateTime?
  closedAt             DateTime?
  closedBy             String?
  totalAreaHa          Float?
  fieldsCount          Int?
  targetYieldTons      Float?
  actualYieldTons      Float?
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  fieldSeasons         FieldSeason[]

  @@map("seasons")
}

// ============================================================================
// 2. KATASTRIÜKSUSED (CADASTRAL PARCELS)
// ============================================================================

model CadastralParcel {
  id             Int                  @id @default(autoincrement())
  cadastralCode  String               @unique // Katastritunnus (nt "89201:001:0100")
  name           String?              // Katastriüksuse nimi / lähiaadress
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  seasonLinks    FieldCadastralParcel[]

  @@map("cadastral_parcels")
}

// ============================================================================
// 3. PÕLLUD / MASSIIVID (MASTER FIELDS)
// ============================================================================

model Field {
  id             Int                    @id @default(autoincrement())
  num            String                 // PRIA põllu number impordist / kasutaja antud (nt "4", "4-1", "x") — võib massiivi siseselt korduda eri operaatoritel
  name           String                 // Kasutaja määratud nimi (nt "Murikatsi Mirka", "Toosi")
  fieldCode      String                 // PRIA massiivi number (nt "60844249726") — võib korduda, kui massiiv on jagatud mitme operaatori vahel
  cadastralCode  String?                // Peamine katastritunnus (tagasiühilduvuse jaoks)
  soilType       String?                // Mullastik (nt "Leostunud liivsavi (LP)")
  drainageSystem Boolean                @default(false)
  operatorId     String?                // Põllu operaator (seotud isikute registrist)
  notes          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  fieldSeasons   FieldSeason[]
  operator       RelatedParty?          @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  // Massiivinumber + põllunumber võivad korduda (nt kui operaator vahetub),
  // aga sama operaator ei saa sama massiivi+põllu numbrit kaks korda omada.
  @@unique([fieldCode, num, operatorId])
  @@index([operatorId])
  @@map("fields")
}

// ============================================================================
// 4. PÕLLU HOOAJA KIRJED (FIELD SEASONS - SEOS PÕLLU JA HOOAJA VAHEL)
// ============================================================================

model FieldSeason {
  id                  Int          @id @default(autoincrement())
  fieldId             Int
  seasonId            Int?
  year                Int
  areaHa              Float        // Selle hooaja haritav pindala
  eligibleAreaHa      Float?       // PRIA toetusõiguslik pindala
  areaChangeReason    String?      // Pindala muutuse põhjus (nt võsastumine, kraavihooldus)
  crop                String
  cropVariety         String?
  cropColor           String       @default("#eab308")
  cropId              String?
  varietyId           String?
  targetYieldTonsHa   Float?
  actualYieldTonsHa   Float?
  workedAreaHa        Float        @default(0)
  workProgress        Float        @default(0)
  status              FieldStatus  @default(NOT_STARTED)
  seedingDate         DateTime?
  harvestDate         DateTime?
  boundaryPointsCount Int?         // Geomeetria tippude/punktide arv
  perimeterM          Float?       // Ümbermõõt meetrites
  notes               String?
  geometry            Json         // GeoJSON Polygon | MultiPolygon
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  field               Field        @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  season              Season?      @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  cadastralParcels    FieldCadastralParcel[]
  cropEntity          Crop?        @relation(fields: [cropId], references: [id], onDelete: SetNull)
  varietyEntity       CropVariety? @relation(fields: [varietyId], references: [id], onDelete: SetNull)
  operations          FieldOperation[]
  fieldWorks          FieldWork[]

  @@unique([fieldId, year])
  @@index([fieldId])
  @@index([seasonId])
  @@index([year])
  @@index([cropId])
  @@index([varietyId])
  @@map("field_seasons")
}

// ============================================================================
// 5. HOOAJAPÕHINE PÕLLU JA KATASTRIÜKSUSE SEOS (FIELD SEASON CADASTRAL PARCEL)
// Salvestab, mitu hektarit, millise omandivormi ja kuludega kataster sellel hooajal põllus on
// ============================================================================

// ============================================================================
// 4. SEOTUD ISIKUD JA PARTNERID (RELATED PARTIES / ENTITIES)
// Füüsilised ja juriidilised isikud: maaomanikud, rentnikud, juhid, kontaktid
// ============================================================================

model RelatedParty {
  id              String                  @id @default(cuid())
  name            String                  // Täisnimi või ärinimi (nt "Loisu Agro OÜ", "Maret Paju")
  type            PartyType               @default(PERSON)
  code            String?                 // Isikukood või registrikood
  vatNumber       String?                 // KMKR number
  roles           PartyRole[]             // Rollid süsteemis
  phone           String?                 // Telefon
  email           String?                 // E-post
  address         String?                 // Postiaadress / asukoht
  bankAccount     String?                 // IBAN arveldusarve (rendimakseteks / maamaksuks)
  notes           String?                 // Märkused
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  cadastralParcels FieldCadastralParcel[]
  vehicles         Vehicle[]
  poiContacts      PointOfInterest[]
  fieldsAsOperator Field[]
  performedOperations FieldOperation[]
  workEntries      WorkEntry[]

  @@map("related_parties")
}

model FieldCadastralParcel {
  id                Int             @id @default(autoincrement())
  fieldSeasonId     Int
  cadastralParcelId Int
  fieldAreaHa       Float           // Hektarid sellest katastriüksusest sellel hooajal
  ownershipType     OwnershipType   @default(OWNED) // Oma maa vs Rent sellel hooajal
  ownerName         String?         // Omaniku nimi sellel hooajal
  ownerPartyId      String?         // Seos seotud isikute registriga
  landTaxEurHa      Float?          // Selle hooaja maamaks hektari kohta (€/ha)
  landTaxEurYear    Float?          // Selle hooaja maamaks kokku (€/a)
  rentFeeEurHa      Float?          // Selle hooaja renditasu hektari kohta (€/ha)
  rentFeeEurYear    Float?          // Selle hooaja renditasu kokku (€/a)
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  fieldSeason       FieldSeason     @relation(fields: [fieldSeasonId], references: [id], onDelete: Cascade)
  cadastralParcel   CadastralParcel @relation(fields: [cadastralParcelId], references: [id], onDelete: Cascade)
  ownerParty        RelatedParty?   @relation(fields: [ownerPartyId], references: [id], onDelete: SetNull)

  @@unique([fieldSeasonId, cadastralParcelId])
  @@index([fieldSeasonId])
  @@index([cadastralParcelId])
  @@index([ownerPartyId])
  @@map("field_cadastral_parcels")
}

// ============================================================================
// 5. TARISTU / HUVI- JA TÖÖPUNKTID (POI)
// ============================================================================

model PointOfInterest {
  id             String        @id @default(cuid())
  name           String
  category       PoiCategory
  latitude       Float
  longitude      Float
  description    String?
  capacity       String?
  contactPerson  String?
  contactPartyId String?
  phone          String?
  accessNotes    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  contactParty   RelatedParty? @relation(fields: [contactPartyId], references: [id], onDelete: SetNull)

  @@index([contactPartyId])
  @@map("points_of_interest")
}

// ============================================================================
// 6. MASINAPARK JA GPS SEADMED (FLEET & TELEMETRY)
// ============================================================================

model Vehicle {
  id                  String           @id @default(cuid())
  name                String
  type                VehicleType
  model               String
  regNumber           String?
  workingWidthM       Float            @default(6.0)
  color               String           @default("#10b981")
  fuelCapacityL       Float?
  assignedDriverId    String?          // Seotud isiku ID (töötaja / masinajuht)
  assignedImplementId String?          @unique
  assignedDeviceId    String?          @unique
  lastLatitude        Float?
  lastLongitude       Float?
  lastActiveAt        DateTime?
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  assignedDriver      RelatedParty?    @relation(fields: [assignedDriverId], references: [id], onDelete: SetNull)
  assignedImplement   Implement?       @relation(fields: [assignedImplementId], references: [id])
  assignedDevice      TeltonikaDevice? @relation(fields: [assignedDeviceId], references: [id])
  deviceAssignments   DeviceAssignment[]
  workEntries         WorkEntry[]
  workEntryLines      WorkEntryLine[]

  @@index([assignedDriverId])
  @@map("vehicles")
}

model Implement {
  id               String           @id @default(cuid())
  name             String
  type             ImplementType
  workingWidthM    Float
  manufacturer     String?
  model            String?
  year             Int?
  assignedDeviceId String?          @unique
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  vehicle          Vehicle?
  assignedDevice   TeltonikaDevice? @relation(fields: [assignedDeviceId], references: [id])
  deviceAssignments DeviceAssignment[]
  workEntries      WorkEntry[]
  workEntryLines   WorkEntryLine[]

  @@map("implements")
}

enum DeviceConnectivity {
  CELLULAR
  EYE_SENSOR
}

model TeltonikaDevice {
  id               String             @id @default(cuid())
  connectivityType DeviceConnectivity @default(CELLULAR)
  imei             String?            @unique  // Kohustuslik ainult CELLULAR seadmetel
  macAddress       String?            @unique  // Kohustuslik ainult EYE_SENSOR seadmetel
  model            String
  simNumber        String?
  firmware         String?
  status           DeviceStatus       @default(OFFLINE)
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  vehicle          Vehicle?
  implement        Implement?
  assignments      DeviceAssignment[]

  @@map("teltonika_devices")
}

model DeviceAssignment {
  id            String          @id @default(cuid())
  deviceId      String
  device        TeltonikaDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  vehicleId     String?
  vehicle       Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  implementId   String?
  implement     Implement?      @relation(fields: [implementId], references: [id], onDelete: SetNull)
  startedAt     DateTime        @default(now())
  endedAt       DateTime?
  lastLatitude  Float?
  lastLongitude Float?
  notes         String?
  createdAt     DateTime        @default(now())

  @@index([deviceId, startedAt])
  @@index([vehicleId, startedAt])
  @@map("device_assignments")
}

// ============================================================================
// 7. KULTUURID JA SORDID (CROPS & VARIETIES REGISTER)
// ============================================================================

enum CropGroup {
  CEREAL          // Teravili (nisu, oder, kaer, rukis)
  OILSEED         // Õlikultuur (raps, rüps)
  LEGUME          // Kaunvili / Liblikõieline (hernes, uba)
  FORAGE_GRASS    // Söödakultuur / Rohumaa (ristik, timut, karjamaa)
  FALLOW          // Kesa (mustkesa, rohekesa)
  OTHER           // Muu kultuur
}

model Crop {
  id                    String        @id
  name                  String        @unique
  scientificName        String?
  group                 CropGroup     @default(CEREAL)
  color                 String        @default("#eab308")
  icon                  String?
  priaCode              String?
  defaultSeedRateKgHa   Float?
  defaultYieldTonsHa    Float?
  description           String?
  isWinterCrop          Boolean       @default(false) // Talivili: külvatakse sügisel (hooaeg algab eelmise aasta sügisel)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  varieties             CropVariety[]
  fieldSeasons          FieldSeason[]
  workTemplates         WorkTemplate[]

  @@map("crops")
}

model CropVariety {
  id                      String        @id
  cropId                  String
  name                    String
  breeder                 String?       // Aretaja / esindaja (nt Saaten-Union, KWS)
  maturityDays            String?       // Valmimisaeg / kasvuaeg
  winterHardiness         String?       // Talvekindlus
  recommendedSeedRateKgHa Float?        // Soovituslik külvinorm kg/ha
  potentialYieldTonsHa    Float?        // Saagipotentsiaal t/ha
  qualityClass            String?       // Kvaliteediklass (nt Toiduvili E, I, söödavili)
  notes                   String?
  isActive                Boolean       @default(true)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  crop                    Crop          @relation(fields: [cropId], references: [id], onDelete: Cascade)
  fieldSeasons            FieldSeason[]

  materials     Material[]

  @@unique([cropId, name])
  @@index([cropId])
  @@map("crop_varieties")
}

// ============================================================================
// 8. MULLAPROOVID (SOIL SAMPLES)
// ============================================================================

model SoilSample {
  id              Int      @id @default(autoincrement())
  sampleNumber    String   @unique // Labori proovinumber ("proovNr") - kordusimpordil kasutatav võti
  fieldCode       String   // PRIA massiivi number ("xy_id") - tekstivõrdlusega seotud Field.fieldCode'iga, mitte range FK (massiiv võib kuuluda mitmele Field kirjele)
  year            Int      // Proovivõtu aasta ("aasta")
  lat             Float
  lng             Float
  ph              Float?
  phosphorus      Float?   // Fosfor (P)
  potassium       Float?   // Kaalium (K)
  calcium         Float?   // Kaltsium (Ca)
  magnesium       Float?   // Magneesium (Mg)
  copper          Float?   // Vask (Cu)
  manganese       Float?   // Mangaan (Mn)
  boron           Float?   // Boor (B)
  organicCarbon   Float?   // Orgaanilise süsiniku sisaldus (Corg)
  limeRequirement Float?   // Lubjatarve t/ha
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([fieldCode])
  @@index([year])
  @@map("soil_samples")
}

// ============================================================================
// 9. PÕLLURAAMAT (FIELD OPERATIONS) — e-PRIA põlluraamatu väljavõtte import
// ============================================================================

model FieldOperation {
  id            Int       @id @default(autoincrement())
  fieldSeasonId Int
  type          String    // PRIA "Tegevus": "Väetamine", "Kündmine", ...
  dateFrom      DateTime
  dateTo        DateTime? // vahemiku lõpp; tühi, kui üks päev
  areaHa        Float?
  method        String?   // "Paisklaotamine", "Pritsimine", "Põhikultuur"
  performerId   String?   // teostaja seotud isikute registrist
  notes         String?
  sortOrder     Int
  createdAt     DateTime  @default(now())

  fieldSeason   FieldSeason             @relation(fields: [fieldSeasonId], references: [id], onDelete: Cascade)
  performer     RelatedParty?           @relation(fields: [performerId], references: [id], onDelete: SetNull)
  products      FieldOperationProduct[]

  @@index([fieldSeasonId])
  @@index([performerId])
  @@map("field_operations")
}

model FieldOperationProduct {
  id               Int     @id @default(autoincrement())
  operationId      Int
  category         String? // "Register/Materjal"
  name             String? // toode, sort või umbrohi
  kind             String? // "Liik/tüüp"
  spec             String? // "Täpsustus"
  amount           Float?
  unit             String?
  nKgHa            Float?
  pKgHa            Float?
  kKgHa            Float?
  activeIngredient String?
  sortOrder        Int

  operation        FieldOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([operationId])
  @@map("field_operation_products")
}

// ============================================================================
// 9b. PÕLLUTÖÖDE REGISTER (PRIA põlluraamatust lahus)
// Tööde register → mallid (üldmall + kultuuri mall) → hooaja põllu tööd →
// kanded (tööpäevad, töötaja sisestab kogused) → read (finantsjuht lisab ühiku kulu).
// ============================================================================

enum WorkPhase {
  PREPARATION // ettevalmistus
  SOWING      // külv
  CARE        // hooldus
  HARVEST     // koristus
}

enum WorkRepeatMode {
  ONCE     // ühekordne
  UP_TO    // kuni maxRepeats korda
  INTERVAL // iga intervalDays päeva järel
}

enum FieldWorkStatus {
  PLANNED
  IN_PROGRESS
  DONE
}

enum WorkEntryLineKind {
  LABOR     // tööaeg (h)
  MACHINE   // masin (h)
  IMPLEMENT // haakeriist (h, sama mis masinal)
  FUEL      // kütus (l)
  MATERIAL  // kulumaterjal
  HARVEST   // saak (t) — tulu
}

enum FinanceStatus {
  PENDING   // ootab finantsjuhti
  CONFIRMED // kinnitatud
  CHANGED   // kogust muudeti pärast kinnitamist — kinnita uuesti
}

enum MaterialCategory {
  SEED
  FERTILIZER
  PLANT_PROTECTION
  OTHER
}

model WorkType {
  id            String         @id @default(cuid())
  name          String         @unique
  phase         WorkPhase
  repeatMode    WorkRepeatMode @default(ONCE)
  maxRepeats    Int?
  intervalDays  Int?
  usesMaterials Boolean        @default(false) // kandes küsitakse kulumaterjale
  sortOrder     Int            @default(0)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  templateItems WorkTemplateItem[]
  fieldWorks    FieldWork[]

  @@map("work_types")
}

model Material {
  id            String           @id @default(cuid())
  name          String
  category      MaterialCategory
  unit          String           // kg, l, t, tk
  cropVarietyId String?          // seemne puhul sort
  isActive      Boolean          @default(true)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  cropVariety   CropVariety?     @relation(fields: [cropVarietyId], references: [id], onDelete: SetNull)
  entryLines    WorkEntryLine[]

  @@unique([category, name])
  @@index([cropVarietyId])
  @@map("materials")
}

// cropId = null → üldmall (isWinter = false → Kevadkülvi mall, isWinter = true → Sügiskülvi mall)
model WorkTemplate {
  id        String   @id @default(cuid())
  cropId    String?
  isWinter  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  crop      Crop?              @relation(fields: [cropId], references: [id], onDelete: Cascade)
  items     WorkTemplateItem[]

  @@unique([cropId, isWinter])
  @@map("work_templates")
}

model WorkTemplateItem {
  id            String  @id @default(cuid())
  templateId    String
  workTypeId    String
  sortOrder     Int     @default(0)
  typicalTiming String? // nt "apr–mai", "eelmine sügis"
  plannedCount  Int?    // korduva töö plaanitud kordi (tühi = töö liigi järgi)

  template      WorkTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  workType      WorkType     @relation(fields: [workTypeId], references: [id], onDelete: Restrict)

  @@unique([templateId, workTypeId])
  @@index([workTypeId])
  @@map("work_template_items")
}

// Hooaja põllu töö (kopeeritakse mallist kultuuri valimisel; lisatav/eemaldatav)
model FieldWork {
  id            String          @id @default(cuid())
  fieldSeasonId Int
  workTypeId    String
  phase         WorkPhase
  sortOrder     Int             @default(0)
  plannedText   String?         // nt "okt 2026"
  plannedCount  Int             @default(1)
  status        FieldWorkStatus @default(PLANNED)
  finishedAt    DateTime?
  finishedById  String?
  fromTemplate  Boolean         @default(false)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  fieldSeason   FieldSeason     @relation(fields: [fieldSeasonId], references: [id], onDelete: Cascade)
  workType      WorkType        @relation(fields: [workTypeId], references: [id], onDelete: Restrict)
  finishedBy    User?           @relation("FieldWorkFinishedBy", fields: [finishedById], references: [id], onDelete: SetNull)
  entries       WorkEntry[]

  @@unique([fieldSeasonId, workTypeId])
  @@index([workTypeId])
  @@map("field_works")
}

// Kanne = üks tööpäev/tööosa; töötaja sisestab ainult kogused
model WorkEntry {
  id                   String        @id @default(cuid())
  fieldWorkId          String
  date                 DateTime
  workerId             String?       // seotud isik (roll Töötaja)
  areaHa               Float?
  occurrenceNo         Int?          // korduva töö mitmes kord
  vehicleId            String?
  implementId          String?
  equipmentHours       Float?        // masina ja haakeriista töötunnid (sisestatakse korraga)
  fuelLiters           Float?
  laborHours           Float?
  notes                String?
  createdById          String?
  financeStatus        FinanceStatus @default(PENDING)
  financeConfirmedAt   DateTime?
  financeConfirmedById String?
  financeNotes         String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  fieldWork            FieldWork     @relation(fields: [fieldWorkId], references: [id], onDelete: Cascade)
  worker               RelatedParty? @relation(fields: [workerId], references: [id], onDelete: SetNull)
  vehicle              Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  implement            Implement?    @relation(fields: [implementId], references: [id], onDelete: SetNull)
  createdBy            User?         @relation("WorkEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  financeConfirmedBy   User?         @relation("WorkEntryConfirmedBy", fields: [financeConfirmedById], references: [id], onDelete: SetNull)
  lines                WorkEntryLine[]

  @@index([fieldWorkId])
  @@index([financeStatus])
  @@index([workerId])
  @@map("work_entries")
}

// Kande finantsrida: kogus töötajalt, ühiku kulu/hind finantsjuhilt (ERP-st käsitsi)
model WorkEntryLine {
  id                String            @id @default(cuid())
  entryId           String
  kind              WorkEntryLineKind
  vehicleId         String?
  implementId       String?
  materialId        String?
  label             String            // nimi salvestamise hetkel
  quantity          Float
  unit              String
  unitPrice         Decimal?          @db.Decimal(12, 4)
  confirmedQuantity Float?            // kogus viimasel kinnitamisel (muudatuse näitamiseks)
  sortOrder         Int               @default(0)

  entry             WorkEntry         @relation(fields: [entryId], references: [id], onDelete: Cascade)
  vehicle           Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  implement         Implement?        @relation(fields: [implementId], references: [id], onDelete: SetNull)
  material          Material?         @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([materialId])
  @@map("work_entry_lines")
}

// ============================================================================
// 10. KASUTAJAD JA SESSIOONID (rakenduse sisselogimine)
// ============================================================================

model User {
  id           String    @id @default(cuid())
  username     String    @unique // väiketähtedega
  passwordHash String
  displayName  String?
  email        String?   @unique
  isActive     Boolean   @default(true)
  isAdmin            Boolean   @default(false)
  mustChangePassword Boolean   @default(false)
  isFinanceManager   Boolean   @default(false) // finantsjuht: kannete ühiku kulud, kinnitamine, põldude tulemus
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions     Session[]
  passwordTokens PasswordToken[]
  finishedFieldWorks  FieldWork[] @relation("FieldWorkFinishedBy")
  createdWorkEntries  WorkEntry[] @relation("WorkEntryCreatedBy")
  confirmedWorkEntries WorkEntry[] @relation("WorkEntryConfirmedBy")

  @@map("users")
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique // SHA-256 küpsise tokenist
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  userAgent  String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordToken {
  id        Int       @id @default(autoincrement())
  userId    String
  purpose   String    // 'INVITE' | 'RESET'
  tokenHash String    @unique // SHA-256 toortokenist (toortoken ainult e-kirjas)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_tokens")
}


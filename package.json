{
  "name": "teris",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.server.config.ts",
    "lint": "oxlint",
    "ui-audit": "npx tsx scripts/ui-audit.mts",
    "preview": "vite preview",
    "pretest": "sh scripts/clean-test-tmp.sh",
    "test": "vitest run",
    "build:server": "vite build --config vite.server.config.ts",
    "user": "node dist-server/userCli.js",
    "tenant": "node dist-server/tenantCli.js",
    "platform": "node dist-server/platformCli.js",
    "start": "node dist-server/prod.js",
    "note": "npx tsx scripts/changelog-note.mts",
    "release:draft": "npx tsx scripts/release-draft.mts",
    "release": "npx tsc --noEmit -p tsconfig.app.json && npm test && npm run build && sudo systemctl restart teris && npm run release:draft -- --include-git-fallback --tag"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/vite": "^4.3.5",
    "@turf/turf": "^7.4.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "3.4.16",
    "h5wasm": "^0.10.3",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.33.0",
    "proj4": "^2.21.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shpjs": "^6.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/proj4": "^2.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/shpjs": "^3.4.7",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^31.0.1",
    "oxlint": "^1.75.0",
    "prisma": "^6.19.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.1"
  }
}

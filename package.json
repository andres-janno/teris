{
  "name": "teris",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.server.config.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "build:server": "vite build --config vite.server.config.ts",
    "user": "node dist-server/userCli.js",
    "start": "node dist-server/prod.js",
    "release": "npx tsc --noEmit -p tsconfig.app.json && npm test && npm run build && sudo systemctl restart teris"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@turf/turf": "^7.4.0",
    "canvas-confetti": "^1.9.4",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.33.0",
    "proj4": "^2.21.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shpjs": "^6.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/proj4": "^2.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/shpjs": "^3.4.7",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "prisma": "^6.19.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.1"
  }
}
